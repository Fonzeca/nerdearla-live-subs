# Copiar a .env y ajustar. Todos tienen default.
WHISPER_MODEL=large-v3-turbo   # small / medium si hay poca VRAM
WHISPER_COMPUTE=float16        # int8_float16 ahorra VRAM
WHISPER_WORKERS=2              # transcripciones en paralelo (~1 por sala)
TRANSLATE_MODEL=gemma3:4b      # gemma3:1b más rápido, gemma3:12b mejor calidad
TARGET_LANG=es
